- var pageDescription = "Mateo Van Damme — software developer from Ghent."
- var pageOgImage = null
- var pageTitle = null
block variables

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= pageTitle ? pageTitle + " | Mateo Van Damme" : "Mateo Van Damme"
    meta(name="description" content=pageDescription)
    meta(property="og:title" content=pageTitle ? pageTitle + " | Mateo Van Damme" : "Mateo Van Damme")
    meta(property="og:description" content=pageDescription)
    meta(property="og:type" content="website")
    if pageOgImage
      meta(property="og:image" content=pageOgImage)
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/css/style.css")
    link(rel="icon" type="image/x-icon" href="/favicon.ico")
    link(rel="canonical" href=pageCanonical)
    block extra_head
  body
    include partials/navbar
    main.container-fluid.py-2
      block content

    block scripts

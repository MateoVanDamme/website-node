-
  const navItems = [
    { name: 'Projects', path: '/' },
    { name: 'Hackerspace', path: '/hackerspace' },
    { name: 'Astrophotography', path: '/astrophotography' },
    { name: '3D Printing', path: '/3d-printing' },
    { name: 'Art', path: '/art' },
  ];

nav
  a.nav-brand(href="/")
    img(src="/logo.svg" alt="Mateo Van Damme" height="22")
  each item in navItems
    if item.external
      a(href=item.path target="_blank" rel="noopener noreferrer")= item.name
    else
      a(href=item.path class=(activePage === item.name ? 'active' : ''))= item.name

extends ../layout

block variables
  - pageTitle = "Hackerspace Gent Website"
  - pageDescription = "The Hackerspace Gent website — a Node.js and Express app with a markdown-powered event system, deployed on Azure."
  - pageOgImage = "https://storage.googleapis.com/mateo-website-bucket/hackerspace-gent-website.png"

block extra_head
  script(type="application/ld+json").
    {
      "@context": "https://schema.org",
      "@type": "SoftwareSourceCode",
      "name": "Hackerspace Gent Website",
      "description": "Node.js and Express website for Hackerspace Gent with a markdown-powered event system, deployed on Azure.",
      "url": "https://hackerspace.gent/",
      "codeRepository": "https://github.com/0x20/website-node",
      "programmingLanguage": ["JavaScript", "Node.js"],
      "author": { "@type": "Person", "name": "Mateo Van Damme" }
    }

block content
  .d-flex.flex-column.mb-5
    p.lead.text-center
      | Website for Hackerspace Gent (0x20), a community space for hackers, makers, and tinkerers in Ghent, Belgium.

    .d-flex.gap-2.mb-3.justify-content-center
      a.btn(href="https://hackerspace.gent/" target="_blank" rel="noopener noreferrer" style="background-color: #9CD900; color: #000; border: none;") Live Site
      a.btn.btn-github(href="https://github.com/0x20/website-node" target="_blank" rel="noopener noreferrer")
        svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 6px;")
          path(d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z")
        | GitHub

  style.
    .masonry-grid {
      column-count: 2;
    }
    /* Small screens */
     @media (max-width: 768px) {
      .masonry-grid {
        column-count: 1;
      }
    }
    .card-body {
      display: flex;
      flex-direction: column;
    }

  section.masonry-grid
    article.card
      img.card-img-top(src="https://storage.googleapis.com/mateo-website-bucket/hackerspace-gent-website.png" alt="Hackerspace Gent Website" style="object-fit: cover; border: 1px solid #884422;")

    article.card
      .card-body
        h5.card-title Markdown-Based Event System
        p.card-text
          | We needed a way to organize events at the hackerspace. Using Google Calendar or Outlook wasn't an option - half the members are on a crusade against big tech.
        p.card-text The criteria for the new system:
        ul
          li Every member should be able to add, edit, and delete events
          li Events should be customizable with images and rich content
          li Still offer a Google Calendar for those who want them
        p.card-text
          | The solution: since every member has a GitHub account anyway, events are just markdown files. Create a #[code .md] file in the #[code /events/] folder, submit a PR, and the website picks it up automatically.

    article.card
      .card-body
        h5.card-title CI/CD (GitHub Actions)
        p.card-text
          | Two GitHub Actions power the site.
        h6 Deployment
        p.card-text
          | On push to main, SSH into the VM, pull the latest code, and rebuild the Docker container. Changes are live within seconds.
        h6 Google Calendar sync
        p.card-text
          | When event markdown files change, the action parses them, and updates the Google Calendar events using the #[code googleapis] Node.js library.
        .tech-icons
          img(src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/githubactions/githubactions-original.svg" alt="GitHub Actions" title="GitHub Actions")
          //- img(src="https://upload.wikimedia.org/wikipedia/commons/a/a5/Google_Calendar_icon_%282020%29.svg" alt="Google Calendar API" title="Google Calendar API")

    article.card
      .card-body
        h5.card-title Node.js + Express
        p.card-text
          | The backend is built with Node.js and Express, using Pug as the templating engine. Simple, fast, and easy for other hackerspace members to contribute to.
        .feature-list
          .feature-item
            span.feature-label Express
            span  web framework
          .feature-item
            span.feature-label Pug
            span  templating
          .feature-item
            span.feature-label Markdown
            span  parsing for events
        .tech-icons
          img(src="images/logos/jsIconGreen.svg" alt="Node.js" title="Node.js")
          img(src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/express/express-original.svg" alt="Express" title="Express")

    article.card
      .card-body
        h5.card-title Azure Deployment
        p.card-text
          | Hosted on Azure App Service. The hackerspace has Azure credits through various sponsorships, so hosting is essentially free.
        .feature-list
          .feature-item
            span.feature-label Azure App Service
            span  for hosting
          .feature-item
            span.feature-label Custom domain
            span  hackerspace.gent
          .feature-item
            span.feature-label SSL
            span  via Azure
        .tech-icons
          img(src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" alt="Docker" title="Docker")
          img(src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/azure/azure-original.svg" alt="Azure" title="Azure" style="height: 3.5rem;")
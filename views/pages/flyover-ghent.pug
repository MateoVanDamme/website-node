extends ../layout

block variables
  - pageTitle = "Flyover Ghent"
  - pageDescription = "Open-source 3D art projects over Ghent — autonomous drone flocking and free-flight through the city using real municipal open data."

block extra_head
  link(rel="stylesheet" href="/css/flyover-ghent.css")
  script(type="application/ld+json").
    {
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      "name": "Flyover Ghent",
      "description": "Open-source 3D art using real city data from Ghent's open data portal.",
      "url": "https://mateovandamme.com/art/flyover-ghent",
      "author": { "@type": "Person", "name": "Mateo Van Damme" },
      "hasPart": [
        { "@type": "SoftwareSourceCode", "name": "Drones Over Ghent", "url": "https://flyover.mateovandamme.com/", "codeRepository": "https://github.com/MateoVanDamme/drones-over-ghent" },
        { "@type": "SoftwareSourceCode", "name": "Fly Over Gent", "url": "https://fly.mateovandamme.com/", "codeRepository": "https://github.com/MateoVanDamme/fly-over-gent" }
      ]
    }

block content
  .flyover-page
    h1.fp-title.fp-hero-title Flyover Ghent
    h5.card-title Open-source 3D art built on real city data. Both projects use the "Gent in 3D" dataset from #[a(href="https://data.stad.gent/" target="_blank" rel="noopener noreferrer") data.stad.gent] to render the city of Ghent in the browser using Three.js.

    p.fp-manifesto(style="margin-top: 1rem; margin-bottom: 0;") As presented at #[a(href="https://nerdlab.be/byob" target="_blank" rel="noopener noreferrer" style="color: var(--accent);") BYOB 2025]

    .d-flex.gap-2(style="margin-top: 1.5rem;")
      a.btn.fp-btn(href="https://flyover.mateovandamme.com/" target="_blank" rel="noopener noreferrer") Drones Over Ghent
      a.btn.fp-btn(href="https://fly.mateovandamme.com/" target="_blank" rel="noopener noreferrer") Fly Over Gent

    div(style="margin-bottom: 28rem;")

    canvas#drone-viewer
    h1.fp-title Projects
    .fp-projects-row
      article.card
        .card-body
          h5.card-title Drones Over Ghent
          .d-flex.gap-2.mb-3
            a.btn.fp-btn(href="https://flyover.mateovandamme.com/" target="_blank" rel="noopener noreferrer") Live Demo
            a.btn.fp-btn-gh(href="https://github.com/MateoVanDamme/drones-over-ghent" target="_blank" rel="noopener noreferrer")
              svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 6px;")
                path(d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z")
              | GitHub
          p.card-text.mb-3
            | Autonomous drone flocking over a 3D model of Ghent. Drones use boid algorithms to exhibit natural swarming behavior above the city skyline.
          .feature-list
            .feature-item
              span.feature-label Boid flocking
              span  with autonomous agents
            .feature-item
              span.feature-label 4 camera modes
              span  follow, chase, orbit, free-flight
            .feature-item
              span.feature-label Real-time GUI
              span  controls for tweaking parameters
          h6.mt-3(style="color: var(--accent);") Controls
          .controls-grid
            kbd 1 2 3 4
            span Camera: follow / chase / orbit / manual
            kbd Tab
            span Cycle to next drone
            kbd WASD
            span Move (manual mode)
            kbd Space / Shift
            span Fly up / down
            kbd Mouse
            span Look around
            kbd I
            span Toggle debug info
            kbd P
            span Respawn drones
          p.card-text.small.text-muted(style="margin-top: 1.5rem;")
            | Built with Three.js and vanilla JavaScript.
      article.card
        .card-body
          h5.card-title Fly Over Gent
          .d-flex.gap-2.mb-3
            a.btn.fp-btn(href="https://fly.mateovandamme.com/" target="_blank" rel="noopener noreferrer") Live Demo
            a.btn.fp-btn-gh(href="https://github.com/MateoVanDamme/fly-over-gent" target="_blank" rel="noopener noreferrer")
              svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="margin-right: 6px;")
                path(d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z")
              | GitHub
          p.card-text.mb-3
            | Free-flight through all of Ghent using official municipal 3D data. Explore 150+ tiles of the city with WASD controls.
          .feature-list
            .feature-item
              span.feature-label WASD free-flight
              span  controls
            .feature-item
              span.feature-label Dynamic tile loading
              span  150+ city tiles
            .feature-item
              span.feature-label Python pipeline
              span  DWG→DXF→STL preprocessing
          h6.mt-3(style="color: var(--accent);") Controls
          .controls-grid
            kbd WASD
            span Move around
            kbd Space / Shift
            span Fly up / down
            kbd Mouse
            span Look around
            kbd I
            span Toggle debug info
          p.card-text.small.text-muted(style="margin-top: 1.5rem;")
            | Built with Three.js. Python preprocessing with ODA File Converter, ezdxf, and trimesh. Lambert-72 coordinates.

    h1.fp-title Data & Pipeline
    .fp-data-row
      .fp-data-left
        article.card(style="margin-bottom: 1rem;")
          .card-body
            h5.card-title The Data
            .d-flex.gap-2.mb-3
              a.btn.fp-btn(href="https://data.stad.gent/explore/dataset/gent-in-3d/information/?sort=vaknummer" target="_blank" rel="noopener noreferrer") Gent in 3D Dataset
            p.card-text
              | The city of Ghent publishes its full 3D model as open data through the "Gent in 3D" dataset. It covers the entire city in 1km² tiles using the Lambert-72 coordinate system — buildings as LOD2 geometry (rooftops modeled from LiDAR, walls extruded from cadastral contours) and terrain from ground-point elevation data.
            .tech-icons
              img(src="/images/logos/stad-gent-opendata.svg" alt="Stad Gent Open Data" title="Stad Gent Open Data" style="height: 4rem; background: white; padding: 4px;")

        article.card
          .card-body
            h5.card-title Processing Pipeline
            p.card-text.mb-3
              | The entire pipeline is automated with #[code python run_all.py --download] — it downloads all 150+ tiles from the Gent open data API, extracts the DWG files, and batch converts them to STL in parallel.
            .pipeline
              .pipeline-step
                .pipeline-box
                  span.pipeline-format .ZIP
                  span.pipeline-tool  downloaded from data.stad.gent API
                .pipeline-arrow ↓
                .pipeline-label download_gent_data.py
              .pipeline-step
                .pipeline-box
                  span.pipeline-format .DWG
                  span.pipeline-tool  LiDAR scan data
                .pipeline-arrow ↓
                .pipeline-label ODA File Converter (cached)
              .pipeline-step
                .pipeline-box
                  span.pipeline-format .DXF
                  span.pipeline-tool  vector geometry
                .pipeline-arrow ↓
                .pipeline-label ezdxf — parse 3DFACE entities
              .pipeline-step
                .pipeline-box
                  span.pipeline-format .STL
                  span.pipeline-tool  triangle meshes (parallel)
                .pipeline-arrow ↓
                .pipeline-label trimesh — mesh export
              .pipeline-step
                .pipeline-box
                  span.pipeline-format Three.js
                  span.pipeline-tool  rendered in browser
      img.fp-map(src="https://storage.googleapis.com/mateo-website-bucket/flyover-ghent-tile-map-red.webp" alt="Overzichtskaart kilometer-vakken")

block scripts
  script.
    const page = document.querySelector('.flyover-page');
    window.addEventListener('scroll', () => {
      const t = Math.max(0, Math.min((window.scrollY - window.innerHeight * 0.15) / (window.innerHeight * 0.7), 1));
      const progress = t * t;
      page.style.setProperty('--hero-opacity', 1 - progress);
    });
  script(type="importmap").
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/"
      }
    }
  script(type="module").
    import * as THREE from 'three';
    import { STLLoader } from 'three/addons/loaders/STLLoader.js';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

    const canvas = document.getElementById('drone-viewer');
    const rect = canvas.getBoundingClientRect();

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setSize(rect.width, rect.height);
    renderer.setPixelRatio(window.devicePixelRatio);

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(45, rect.width / rect.height, 0.1, 1000);
    camera.position.set(3, 2, 3);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 1;
    controls.enableZoom = false;
    controls.enablePan = false;
    controls.enableRotate = false;

    const ambient = new THREE.AmbientLight(0xffffff, 1.5);
    scene.add(ambient);
    const dir = new THREE.DirectionalLight(0xffffff, 2);
    dir.position.set(5, 5, 5);
    scene.add(dir);

    const loader = new STLLoader();
    loader.load('/models/drone.stl', (geometry) => {
      geometry.computeBoundingBox();
      const center = new THREE.Vector3();
      geometry.boundingBox.getCenter(center);
      geometry.translate(-center.x, -center.y, -center.z);

      const material = new THREE.MeshStandardMaterial({
        color: 0xff0000,
        metalness: 0.3,
        roughness: 0.7
      });

      const mesh = new THREE.Mesh(geometry, material);
      mesh.rotation.x = -Math.PI / 2;

      const box = new THREE.Box3().setFromObject(mesh);
      const size = box.getSize(new THREE.Vector3()).length();
      mesh.scale.multiplyScalar(3 / size);

      scene.add(mesh);
    });

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      const r = canvas.getBoundingClientRect();
      camera.aspect = r.width / r.height;
      camera.updateProjectionMatrix();
      renderer.setSize(r.width, r.height);
    });
